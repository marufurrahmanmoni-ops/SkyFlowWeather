<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark navy launch screen while Flutter starts. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/skyflow_navy</item>
        <item name="android:navigationBarColor">@color/skyflow_navy</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/skyflow_navy</item>
    </style>
</resources>
